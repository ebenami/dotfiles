#!/usr/bin/env bash
set -euo pipefail
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" == /* ]] || script_path="$script_dir/$script_path"
done
repo_root="$(cd "$(dirname "$script_path")/.." && pwd -P)"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.local/share/fnm:$HOME/.local/share/fnm/aliases/default/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.pyenv/shims:$HOME/bin:$PATH"
exec uv run --default-index https://pypi.org/simple --script "$repo_root/setup/env.py" "$@"
