execute pathogen#infect()

" set t_Co=256
syntax enable
set background=dark  

" set encoding=utf-8
set hlsearch
" set incsearch
" :set nu " show linu numbers
set ignorecase
set smartcase
" set laststatus=2
set pastetoggle=<F2>
let g:gitgutter_grep_command = 'grep'

" Uncomment below to cause 'tilde backup files' to be created in a different dir so as not to clutter up the current file's directory (probably a better idea than disabling them altogether)
set backupdir=~/.vim/backups//
set directory=~/.vim/swapfiles//

" Uncomment below to disable 'swap files' (eg. .myfile.txt.swp) from being created
" set noswapfile

" Indentation
filetype plugin indent on
" show existing tab with 2 spaces width
set tabstop=2
" when indenting with '>', use 2 spaces width
set shiftwidth=2
" On pressing tab, insert 2 spaces
set expandtab

autocmd FileType javascript setlocal shiftwidth=3 tabstop=3 
autocmd FileType python     setlocal shiftwidth=4 softtabstop=4 

" Jenkinsfile
autocmd BufRead,BufNewFile Jenkinsfile set ft=groovy
autocmd BufRead,BufNewFile Jenkinsfile* setf groovy
autocmd BufRead,BufNewFile *.jenkinsfile set ft=groovy
autocmd BufRead,BufNewFile *.jenkinsfile setf groovy
" au BufNewFile,BufRead Jenkinsfile setf groovy

" vim -b : edit binary using xxd-format!
augroup Binary
  au!
  au BufReadPre  *.vt let &bin=1
  au BufReadPost *.vt if &bin | %!xxd
  au BufReadPost *.vt set ft=xxd | endif
  au BufWritePre *.vt if &bin | %!xxd -r
  au BufWritePre *.vt endif
  au BufWritePost *.vt if &bin | %!xxd
  au BufWritePost *.vt set nomod | endif
augroup END

" Switch buffers in vim without saving to a currently modified file
:set hidden
:set nowrap
" automatically load changed files
:set autoread
set mouse=a

