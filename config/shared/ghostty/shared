# Colors converted from iTerm2 profile: Default
background = 000000
foreground = bbbbbb
split-divider-color = bbbbbb
window-padding-x = 6
window-padding-y = 4
cursor-color = bbbbbb
cursor-text = ffffff
selection-background = b5d5ff
selection-foreground = 000000
bold-color = ffffff
palette = 0=000000
palette = 1=bb0000
palette = 2=00bb00
palette = 3=bbbb00
palette = 4=0000bb
palette = 5=bb00bb
palette = 6=00bbbb
palette = 7=bbbbbb
palette = 8=555555
palette = 9=ff5555
palette = 10=55ff55
palette = 11=ffff55
palette = 12=5555ff
palette = 13=ff55ff
palette = 14=55ffff
palette = 15=ffffff

font-size = 12
window-width = 80
window-height = 25
background-opacity = 1
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
scrollback-limit = 4294967295
mouse-reporting = false
copy-on-select = both
bell-features = system,attention,title
confirm-close-surface = false
cursor-style-blink = false
shell-integration-features = no-title
quit-after-last-window-closed = true
window-theme = light
keybind = ctrl+insert=copy_to_clipboard
keybind = super+left=previous_tab
keybind = super+right=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = super+shift+left=move_tab:-1
keybind = super+shift+right=move_tab:+1
keybind = super+left_bracket=previous_tab
keybind = super+right_bracket=next_tab
keybind = super+shift+left_bracket=move_tab:-1
keybind = super+shift+right_bracket=move_tab:+1
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = ctrl+shift+6=text:\x1e
keybind = shift+up=esc:[A
keybind = ctrl+up=esc:[A
keybind = ctrl+shift+up=esc:[A
keybind = alt+up=esc:[A
keybind = shift+down=esc:[B
keybind = ctrl+down=esc:[B
keybind = ctrl+shift+down=esc:[B
keybind = alt+down=esc:[B
keybind = shift+left=esc:[D
keybind = alt+left=esc:b
keybind = ctrl+left=esc:b
keybind = shift+right=esc:[C
keybind = ctrl+shift+right=esc:[C
keybind = alt+right=esc:f
keybind = ctrl+right=esc:f
keybind = shift+f5=esc:[25~
keybind = shift+f6=esc:[26~
keybind = shift+f7=esc:[28~
keybind = shift+f8=esc:[29~
keybind = shift+home=esc:[H
keybind = shift+end=esc:[F
keybind = home=text:\x01
keybind = end=text:\x05
keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down

